{
  "manifest_version": 3,
  "name": "Extension Memory Saver",
  "short_name": "EMS",
  "version": "0.2.0",
  "description": "Control site-related Chrome extensions and import benchmark-backed memory estimates.",
  "homepage_url": "https://github.com/lcm1226/extension-memory-saver",
  "permissions": [
    "alarms",
    "management",
    "storage",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Extension Memory Saver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      }
    }
  }
}
