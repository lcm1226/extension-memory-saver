{
  "manifest_version": 3,
  "name": "EMS MVP",
  "version": "0.1.0",
  "description": "Site-aware extension control panel with benchmark-backed guidance.",
  "permissions": [
    "management",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EMS MVP",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      }
    }
  }
}
